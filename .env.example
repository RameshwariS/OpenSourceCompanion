# Generate each with: openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Server-side token for public GitHub search (no scopes needed)
GITHUB_TOKEN=

# GitHub OAuth (optional). Needs its OWN OAuth app, because the callback URL differs from local dev.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

CLIENT_URL=http://localhost:8080
WEB_PORT=8080

# false only because this demo runs over http://. Remove it behind HTTPS.
COOKIE_SECURE=false